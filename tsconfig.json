{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["es2021"],
    "module": "CommonJS",
    "rootDir": "",
    "outDir": "dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "scripts/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "test", "src/utils/ship.deploy.ts"]
}